# Порт приложения на вашем компьютере.
APP_PORT=8084

# Метаданные текущего развёртывания.
APP_VERSION=1.3.0
APP_ENVIRONMENT=development

# Параметры сервера Gunicorn.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30

# Локальный стек мониторинга.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Обязательный пароль: задайте уникальное значение перед запуском Grafana.
GRAFANA_ADMIN_PASSWORD=
