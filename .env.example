# Порт приложения на вашем компьютере.
APP_PORT=8084

# Метаданные текущего развёртывания.
APP_VERSION=1.3.0
APP_ENVIRONMENT=development

# Локальный стек мониторинга.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Обязательный пароль: задайте уникальное значение перед запуском Grafana.
GRAFANA_ADMIN_PASSWORD=
